# Copy to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

# Postgres connection string, e.g.:
# postgresql://user:password@host:5432/chemeng_portal
DATABASE_URL=.....
DATABASE_SSL=true   # set to "true" for most managed hosts (Render, Supabase, Neon, Railway)

# Comma-separated list of allowed frontend origins for CORS, e.g.
# ALLOWED_ORIGINS=https://chell.yourdomain.com,http://localhost:5173
ALLOWED_ORIGINS=https://chemeng-portal.vercel.app,http://localhost:5173

# The single shared password for the hidden /admin page (not a per-user login).
ADMIN_PASSWORD=chem-ju-2027
# Random long string used to sign admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=6b76d0656e4b983f9400ad424caf13b1a3d9ec032297625a44698bb8fce71fa4294445e00ba7e20f8a6340b6b700f21f

# Automatically publish newly submitted member profiles (true or false).
AUTO_APPROVE_MEMBERS=false

# Email — Resend
RESEND_API_KEY=
EMAIL_FROM=
APP_NAME=ChemEng Portal
APP_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=